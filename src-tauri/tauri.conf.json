{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextClip",
  "version": "0.1.0",
  "identifier": "com.example.textclip",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TextClip",
        "width": 1360,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
