{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextClip",
  "version": "0.1.0",
  "identifier": "com.example.textclip",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TextClip",
        "width": 1360,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxOTc1RkM5MTNFMjdCNDQKUldSRWUrSVR5VitYOGZ6NnIveVZjM3l1azJoOExLU1hEbW8ySTBLbGNOaTlhWjl5WjAvRnJTNHcK",
      "endpoints": [
        "https://github.com/MichalPost/jl/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
